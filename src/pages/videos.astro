---
// Old address: /videos is now /broadcast (kept so existing links still work).
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const to = `${BASE}/broadcast`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <meta name="robots" content="noindex" />
    <title>Redirecting…</title>
  </head>
  <body><a href={to}>Continue to Broadcast</a></body>
</html>
