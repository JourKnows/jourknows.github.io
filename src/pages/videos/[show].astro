---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import getUniqueTags from "@utils/getUniqueTags";
import { getVideos, getShows } from "@utils/videos";
import "@styles/base.css";
import AppNavbar from "@components/AppNavbar";
import AppFooter from "@components/AppFooter.astro";
import VideoCarousel from "@components/VideoCarousel.astro";

// One page per desk / show: /videos/<show-name>. Same look as /videos.
export async function getStaticPaths() {
  const shows = getShows(await getVideos());
  return shows.map(s => ({ params: { show: s.slug }, props: { show: s } }));
}

const { show } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");

const posts = await getCollection("blog");
const allTags = getUniqueTags(posts);
const navLinks = [
  { label: "HOME", href: `${BASE}/` },
  ...allTags.map(t => ({
    label: t.tagName.toUpperCase(),
    href: `${BASE}/tags/${t.tag}`,
  })),
  { label: "VIDEOS", href: `${BASE}/videos` },
];
---

<Layout title={`JourKnows | ${show.name} Videos`}>
  <script is:inline>
    document.documentElement.classList.add("jk-js");
  </script>

  <div class="font-display min-h-[100vh] bg-[#fdfdfb] m-0 p-0 text-[#1e1e1e]">
    <AppNavbar client:load activeHref={`${BASE}/videos`} navLinks={navLinks} />

    <main id="main" class="jk-vid">
      <div class="jk-vid-in">
        <VideoCarousel
          title={show.name}
          subtitle="From the JourKnows Broadcasting Desk."
          videos={show.videos}
          href={`${BASE}/videos`}
          hrefLabel="All videos"
        />
      </div>
    </main>

    <AppFooter />
  </div>
</Layout>
