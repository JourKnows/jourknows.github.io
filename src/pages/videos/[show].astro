---
import { getVideos, getShows } from "@utils/videos";
// Old address: /videos/<show> is now /broadcast/<show> (kept so existing links still work).
export async function getStaticPaths() {
  return getShows(await getVideos()).map(s => ({ params: { show: s.slug } }));
}
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const to = `${BASE}/broadcast/${Astro.params.show}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <meta name="robots" content="noindex" />
    <title>Redirecting…</title>
  </head>
  <body><a href={to}>Continue to Broadcast</a></body>
</html>
