---
import Layout from "@layouts/Layout.astro";
import AppNavbar from "@components/AppNavbar";
import AppFooter from "@components/AppFooter.astro";

import SmallCard from "@components/SmallCard.astro";
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import { SITE } from "@config";

import { getCollection } from "astro:content";
import getSortedPosts from "@utils/getSortedPosts";
import getUniqueTags from "@utils/getUniqueTags";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
  locale,
  authorTitle,
  authorBio,
  authorImage,
  illustrator,
  illustratorImage,
  copyeditor,
  copyeditorImage,
} = post.data;

const { Content } = await post.render();

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(ogImageUrl ?? `/posts/${post.slug}.png`, Astro.url.origin)
  .href;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogUrl,
  scrollSmooth: true,
  locale,
};

// Format dates nicely
const pubDateStr = new Date(pubDatetime).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  hour: "numeric",
  minute: "2-digit",
});

// Grab recent posts for "Related articles"
const allPosts = await getCollection("blog");
const recentRelated = getSortedPosts(allPosts)
  .filter(p => p.slug !== post.slug)
  .slice(0, 4);

const tagsAll = getUniqueTags(allPosts);

const navLinks = [
  { label: "HOME", href: "/" },
  ...tagsAll.map(t => ({
    label: t.tagName.toUpperCase(),
    href: `/tags/${t.tag}`,
  })),
];
---

<Layout {...layoutProps}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "NewsArticle",
      headline: title,
      description: description,
      image: [ogUrl],
      datePublished: pubDatetime,
      dateModified: modDatetime || pubDatetime,
      author: [
        {
          "@type": "Person",
          name: author,
          url: SITE.website,
        },
        ...(illustrator
          ? [
              {
                "@type": "Person",
                name: illustrator,
                url: SITE.website,
              },
            ]
          : []),
        ...(copyeditor
          ? [
              {
                "@type": "Person",
                name: copyeditor,
                url: SITE.website,
              },
            ]
          : []),
      ],
      publisher: {
        "@type": "Organization",
        name: SITE.title,
        logo: {
          "@type": "ImageObject",
          url: SITE.website + "assets/logo.png",
        },
      },
    })}
  />
  <AppNavbar
    client:load
    activeHref={`/tags/${tags[0] ? slugifyStr(tags[0]) : "news"}`}
    navLinks={navLinks}
  />

  <div class="jk-page bg-[#f5f6fa] min-h-screen text-[#1e1e1e] font-display">
    {/* ── Content ── */}
    <div
      class="max-w-[1080px] mx-auto px-5 sm:px-8 lg:px-12 pt-[28px] sm:pt-[34px] lg:pt-[42px] pb-4 bg-white sm:rounded-3xl border border-black/5 sm:mt-6 lg:mt-8 mb-8 shadow-[0_12px_40px_rgba(0,0,0,0.06)] transition-all duration-500"
    >
      {/* ── Top Header Section (TikTok-inspired) ── */}
      <div class="relative flex flex-col gap-5 mb-8 mt-2">
        <div class="flex items-center justify-between w-full">
          {/* Floating Back Button */}
          <button
            onclick="(() => (history.length === 1) ? window.location = '/' : history.back())()"
            class="group flex items-center justify-center w-[42px] h-[42px] bg-black/[0.04] hover:bg-black/[0.08] active:bg-black/[0.12] rounded-full transition-all duration-150 ease-out cursor-pointer text-[#1e1e1e] hover:scale-[1.05] active:scale-[0.92] shadow-[0_2px_8px_rgba(0,0,0,0.02)]"
            aria-label="Go Back"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="group-hover:-translate-x-0.5 transition-transform duration-150"
            >
              <path d="M19 12H5M12 19l-7-7 7-7"></path>
            </svg>
          </button>

          {/* Category Badge (Clickable Nav Pill) */}
          <a
            href={`/tags/${tags[0] ? slugifyStr(tags[0]) : "news"}`}
            class="bg-[#1e1e1e] hover:bg-[#0007d3] px-[16px] py-[8px] rounded-full shadow-sm hover:shadow-md transition-all duration-150 ease-out hover:-translate-y-0.5 active:translate-y-0 active:scale-95 flex items-center gap-1.5 no-underline group"
          >
            <span
              class="w-1.5 h-1.5 rounded-full bg-[#ff0050] group-hover:bg-white transition-colors duration-200"
            ></span>
            <span
              class="font-display font-extrabold text-[11px] tracking-wider text-white uppercase mt-[1px]"
            >
              {tags[0] || "NEWS"}
            </span>
          </a>
        </div>

        {/* Title */}
        <h1
          class="font-display font-black text-[28px] sm:text-[36px] lg:text-[46px] text-[#1e1e1e] leading-[1.1] tracking-tight"
        >
          {title}
        </h1>

        {/* Author and Date Meta (App-style inline) */}
        <div
          class="flex flex-wrap items-center gap-3 sm:gap-4 text-[14px] sm:text-[15px] font-display mt-1"
        >
          {/* Avatar Group */}
          <div class="flex items-center">
            {
              author && (
                <div class="relative z-30">
                  {authorImage ? (
                    <img
                      src={authorImage}
                      alt={author}
                      class="w-8 h-8 rounded-full object-cover shadow-sm border border-white"
                    />
                  ) : (
                    <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-[#0007d3] to-[#ff0050] flex items-center justify-center text-white text-[12px] font-bold shadow-sm border border-white">
                      {author.charAt(0).toUpperCase()}
                    </div>
                  )}
                </div>
              )
            }
            {
              illustrator && (
                <div class:list={["relative z-20", { "-ml-3": author }]}>
                  {illustratorImage ? (
                    <img
                      src={illustratorImage}
                      alt={illustrator}
                      class="w-8 h-8 rounded-full object-cover shadow-sm border border-white"
                    />
                  ) : (
                    <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-[#ff0050] to-[#ffbe0b] flex items-center justify-center text-white text-[12px] font-bold shadow-sm border border-white">
                      {illustrator.charAt(0).toUpperCase()}
                    </div>
                  )}
                </div>
              )
            }
            {
              copyeditor && (
                <div
                  class:list={[
                    "relative z-10",
                    { "-ml-3": author || illustrator },
                  ]}
                >
                  {copyeditorImage ? (
                    <img
                      src={copyeditorImage}
                      alt={copyeditor}
                      class="w-8 h-8 rounded-full object-cover shadow-sm border border-white"
                    />
                  ) : (
                    <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-[#00b4d8] to-[#0077b6] flex items-center justify-center text-white text-[12px] font-bold shadow-sm border border-white">
                      {copyeditor.charAt(0).toUpperCase()}
                    </div>
                  )}
                </div>
              )
            }
          </div>

          {/* Text Names & Roles */}
          <div
            class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[#1e1e1e]/85"
          >
            {
              author && (
                <span>
                  By <span class="font-bold text-[#1e1e1e]">{author}</span>
                </span>
              )
            }
            {
              author && (illustrator || copyeditor) && (
                <span class="text-[#1e1e1e]/30 font-bold">•</span>
              )
            }
            {
              illustrator && (
                <span>
                  Graphics by{" "}
                  <span class="font-bold text-[#1e1e1e]">{illustrator}</span>
                </span>
              )
            }
            {
              illustrator && copyeditor && (
                <span class="text-[#1e1e1e]/30 font-bold">•</span>
              )
            }
            {
              copyeditor && (
                <span>
                  Copyedited by{" "}
                  <span class="font-bold text-[#1e1e1e]">{copyeditor}</span>
                </span>
              )
            }
            {
              (author || illustrator || copyeditor) && (
                <span class="text-[#1e1e1e]/30 font-bold">•</span>
              )
            }
            <span class="font-semibold text-[#1e1e1e]/60">{pubDateStr}</span>
          </div>
        </div>
      </div>
      <hr class="border-black/5 mb-8" />

      <article
        id="article"
        class="prose max-w-none w-full overflow-hidden break-words text-justify mt-8 mb-8 font-display"
      >
        <Content />
      </article>

      {/* ── Mini Writer Profile (Redesigned) ── */}
      {
        authorBio && (
          <div class="mb-12 mt-4">
            <div class="relative w-full rounded-[24px] overflow-hidden bg-white border border-black/5 shadow-[0_12px_40px_rgba(0,0,0,0.06)]">
              {/* Blue Background Bottom Half */}
              <div class="absolute bottom-0 left-0 w-full h-[55%] bg-[#0f0b83]" />

              <div class="relative px-6 pt-8 pb-10 sm:px-10">
                {/* Title */}
                <h2 class="font-display font-black text-[20px] sm:text-[24px] text-[#0f0b83] uppercase tracking-widest mb-8 sm:mb-10">
                  ABOUT THE WRITER
                </h2>

                <div class="flex flex-col sm:flex-row items-center sm:items-stretch gap-6 sm:gap-10 relative z-10">
                  {/* Avatar (Centers on the boundary) */}
                  <div class="shrink-0 flex items-center justify-center">
                    {authorImage ? (
                      <img
                        src={authorImage}
                        alt={author}
                        class="w-[140px] h-[140px] sm:w-[160px] sm:h-[160px] rounded-full object-cover shadow-[0_12px_40px_rgba(0,0,0,0.25)] bg-[#0f0b83]"
                      />
                    ) : (
                      <div class="w-[140px] h-[140px] sm:w-[160px] sm:h-[160px] rounded-full bg-gradient-to-tr from-[#0007d3] to-[#ff0050] flex items-center justify-center text-white text-[64px] font-black shadow-[0_12px_40px_rgba(0,0,0,0.25)]">
                        {author.charAt(0).toUpperCase()}
                      </div>
                    )}
                  </div>

                  {/* Bio Box (Centers on the boundary) */}
                  <div class="flex-1 w-full flex flex-col justify-center bg-white rounded-[18px] border border-[#838be4] shadow-sm p-6 sm:p-8 relative">
                    <h3 class="font-display font-black text-[19px] text-[#1e1e1e] mb-1">
                      {author}
                    </h3>
                    {authorTitle && (
                      <p class="font-display font-bold text-[12.5px] text-[#0007d3] uppercase tracking-wider mb-3">
                        {authorTitle}
                      </p>
                    )}
                    <p class="font-sans text-[15px] sm:text-[15.5px] text-[#555] leading-relaxed mb-0 text-justify">
                      {authorBio}
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )
      }

      {/* ── Comments & Reactions (Zoomment) ── */}
      <div class="border-t-2 border-[#0007d3] pt-6 mb-12 mt-8">
        <h2
          class="font-display font-extrabold text-[17px] sm:text-[22px] text-[#000055] mb-6"
        >
          Community Discussion
        </h2>
        <div
          id="zoomment"
          data-theme="light"
          data-language="en"
          data-gravatar="monsterid"
          data-emotions="👍,👎,❤️,😂,😢,😮,😡"
          data-visitors="true"
        >
        </div>
        <script is:inline src="https://cdn.zoomment.com/zoomment.min.js"
        ></script>
      </div>

      {/* ── Related articles ── */}
      <div class="border-t-[2px] border-[#0007d3] pt-[22px] mb-8 lg:mb-12">
        <h2
          class="font-display font-extrabold text-[17px] sm:text-[22px] text-[#000055] mb-[18px]"
        >
          RELATED ARTICLES
        </h2>
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[9px] sm:gap-[18px]"
        >
          {
            recentRelated.map(relatedPost => (
              <SmallCard
                post={relatedPost}
                category={relatedPost.data.tags[0] || "NEWS"}
              />
            ))
          }
        </div>
      </div>

      {/* ── Back to Home ── */}
      <div class="text-center pb-10">
        <a
          href="/"
          class="jk-btn inline-block bg-transparent border-2 border-[#0007d3] rounded-[20px] px-6 py-[10px] cursor-pointer font-display font-extrabold text-[#0007d3] hover:bg-[#0007d3] hover:text-white transition-colors text-[13px] no-underline"
        >
          ← BACK TO HOME
        </a>
      </div>
    </div>

    <AppFooter />
  </div>
</Layout>

<style>
  .prose {
    font-size: 16px;
    line-height: 1.8;
    letter-spacing: -0.01em;
  }
  @media (min-width: 640px) {
    .prose {
      font-size: 18px;
    }
  }
  @media (min-width: 1024px) {
    .prose {
      font-size: 19px;
      line-height: 1.85;
    }
  }
  .prose :global(p) {
    @apply mb-[22px];
  }
  .prose :global(img) {
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 10px;
    object-fit: cover;
    @apply shadow-sm;
  }
</style>
