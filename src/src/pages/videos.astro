---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import getUniqueTags from "@utils/getUniqueTags";
import "@styles/base.css";
import AppNavbar from "@components/AppNavbar";
import AppFooter from "@components/AppFooter.astro";

// Works at a domain root ("/") and under a sub-folder
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (u: string) =>
  u.startsWith("/") && !u.startsWith("//") ? `${BASE}${u}` : u;

/* ── Navbar links: same as the home page + VIDEOS ── */
const posts = await getCollection("blog");
const allTags = getUniqueTags(posts);
const navLinks = [
  { label: "HOME", href: `${BASE}/` },
  ...allTags.map(t => ({
    label: t.tagName.toUpperCase(),
    href: `${BASE}/tags/${t.tag}`,
  })),
  { label: "VIDEOS", href: `${BASE}/videos` },
];

/* ── Videos (src/content/videos/*.md) ── */
type Kind = "youtube" | "facebook" | "file";
const YT = /(?:youtu\.be\/|youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/|live\/))([\w-]{11})/;

const describe = (raw: string) => {
  const url = raw.trim();
  const yt = url.match(YT);
  if (yt) {
    return {
      kind: "youtube" as Kind,
      embed: `https://www.youtube-nocookie.com/embed/${yt[1]}?autoplay=1&rel=0`,
      thumb: `https://i.ytimg.com/vi/${yt[1]}/hqdefault.jpg`,
    };
  }
  if (/facebook\.com|fb\.watch/i.test(url)) {
    return {
      kind: "facebook" as Kind,
      embed: `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(url)}&show_text=false&autoplay=true`,
      thumb: null,
    };
  }
  return { kind: "file" as Kind, embed: withBase(url), thumb: null };
};

const LABEL: Record<Kind, string> = { youtube: "YOUTUBE", facebook: "FACEBOOK", file: "VIDEO" };

const formatDate = (d?: Date | string) =>
  d
    ? new Date(d).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })
    : "";

let entries: Awaited<ReturnType<typeof getCollection<"videos">>> = [];
try {
  entries = await getCollection("videos", ({ data }: any) => !data.draft);
} catch {
  entries = [];
}

const videos = entries
  .sort(
    (a: any, b: any) =>
      new Date(b.data.pubDatetime).getTime() - new Date(a.data.pubDatetime).getTime()
  )
  .map((v: any) => {
    const d = describe(v.data.url);
    return {
      id: v.id,
      show: (v.data.show || "Broadcast").trim(),
      live: !!v.data.live,
      featured: !!v.data.featured,
      title: v.data.title,
      description: v.data.description || "",
      author: v.data.author || "JourKnows Broadcast",
      date: formatDate(v.data.pubDatetime),
      kind: d.kind,
      label: LABEL[d.kind],
      embed: d.embed,
      thumb: v.data.thumbnail ? withBase(v.data.thumbnail) : d.thumb,
    };
  });

// One accent colour per show, used on each card's label
const TAG_COLORS = ["#e63946", "#1d4ed8", "#f77f00", "#2a9d8f", "#7b2cbf", "#d6336c", "#2b9348", "#0b1f66"];
const showNames: string[] = [];
for (const v of videos) if (!showNames.includes(v.show)) showNames.push(v.show);
const colorOf = (show: string) => TAG_COLORS[showNames.indexOf(show) % TAG_COLORS.length];
// A live video always goes first
videos.sort((x, y) => Number(y.live) - Number(x.live));
---

<Layout title="JourKnows | Videos">
  <script is:inline>
    document.documentElement.classList.add("jk-js");
  </script>

  <div class="font-display min-h-[100vh] bg-[#fdfdfb] m-0 p-0 text-[#1e1e1e]">
    <AppNavbar client:load activeHref={`${BASE}/videos`} navLinks={navLinks} />

    <main id="main" class="jk-vid">
      <div class="jk-vid-in">
        <header class="jk-vid-head">
          <h1 class="jk-vid-title">Videos</h1>
          <p>From the JourKnows Broadcasting Desk.</p>
        </header>

        {
          videos.length === 0 ? (
            <p class="jk-vid-empty">No videos yet — check back soon.</p>
          ) : (
            <section class="jk-vid-car" aria-roledescription="carousel" aria-label="Videos">
              <button type="button" class="jk-vid-arrow is-prev" id="vidPrev" aria-label="Previous video">‹</button>
              <div class="jk-vid-track" id="vidTrack" tabindex="0">
                {videos.map(v => (
                  <button
                    type="button"
                    class="jk-vid-card"
                    style={`--desk:${colorOf(v.show)}`}
                    data-kind={v.kind}
                    data-embed={v.embed}
                    data-title={v.title}
                    aria-label={`Play video: ${v.title}`}
                  >
                    <span class="jk-vid-thumb">
                      {v.thumb && <img src={v.thumb} alt="" loading="lazy" decoding="async" />}
                      <span class="jk-vid-shade" aria-hidden="true" />
                      <span class="jk-vid-play" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                      </span>
                      <span class:list={["jk-vid-badge", v.live && "is-live"]}>
                        {v.live ? "LIVE" : v.show}
                      </span>
                    </span>
                    <span class="jk-vid-meta">
                      <span class="jk-vid-name">{v.title}</span>
                      <span class="jk-vid-by">{v.author}{v.date && ` · ${v.date}`}</span>
                    </span>
                  </button>
                ))}
              </div>
              <button type="button" class="jk-vid-arrow is-next" id="vidNext" aria-label="Next video">›</button>
              <span class="jk-vid-count" id="vidCount" aria-live="polite">1 / {videos.length}</span>
            </section>
          )
        }
      </div>
    </main>

    <AppFooter />

    <div class="jk-vid-modal" id="vidModal" hidden>
      <div class="jk-vid-panel" role="dialog" aria-modal="true" aria-label="Video player">
        <button type="button" class="jk-vid-close" id="vidClose" aria-label="Close video">✕</button>
        <div class="jk-vid-stage" id="vidStage"></div>
        <p class="jk-vid-cap" id="vidCap"></p>
      </div>
    </div>
  </div>

  <script>
    const modal = document.getElementById("vidModal") as HTMLElement | null;
    const stage = document.getElementById("vidStage") as HTMLElement | null;
    const cap = document.getElementById("vidCap") as HTMLElement | null;
    let lastFocus: HTMLElement | null = null;

    const close = () => {
      if (!modal || !stage) return;
      modal.hidden = true;
      stage.innerHTML = ""; // removes the player so playback stops
      document.body.style.overflow = "";
      lastFocus?.focus();
    };

    const open = (card: HTMLElement) => {
      if (!modal || !stage || !cap) return;
      const kind = card.dataset.kind;
      const src = card.dataset.embed || "";
      lastFocus = card;
      stage.innerHTML = "";
      if (kind === "file") {
        const v = document.createElement("video");
        v.src = src;
        v.controls = true;
        v.autoplay = true;
        v.playsInline = true;
        stage.appendChild(v);
      } else {
        const f = document.createElement("iframe");
        f.src = src;
        f.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
        f.allowFullscreen = true;
        f.title = card.dataset.title || "Video";
        stage.appendChild(f);
      }
      cap.textContent = card.dataset.title || "";
      modal.hidden = false;
      document.body.style.overflow = "hidden";
      document.getElementById("vidClose")?.focus();
    };

    document.querySelectorAll<HTMLElement>("[data-embed]").forEach(c =>
      c.addEventListener("click", () => open(c))
    );
    // Carousel: [<] [>] move one video at a time
    const track = document.getElementById("vidTrack") as HTMLElement | null;
    const prev = document.getElementById("vidPrev") as HTMLButtonElement | null;
    const next = document.getElementById("vidNext") as HTMLButtonElement | null;
    const count = document.getElementById("vidCount");
    if (track && prev && next) {
      const cards = Array.from(track.querySelectorAll<HTMLElement>(".jk-vid-card"));
      const step = () => (cards[1] ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth);
      const current = () => Math.min(cards.length - 1, Math.round(track.scrollLeft / Math.max(1, step())));
      const sync = () => {
        const max = track.scrollWidth - track.clientWidth - 2;
        prev.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft >= max;
        if (count) count.textContent = `${current() + 1} / ${cards.length}`;
      };
      prev.addEventListener("click", () => track.scrollBy({ left: -step() }));
      next.addEventListener("click", () => track.scrollBy({ left: step() }));
      track.addEventListener("keydown", e => {
        if (e.key === "ArrowRight") { e.preventDefault(); track.scrollBy({ left: step() }); }
        if (e.key === "ArrowLeft") { e.preventDefault(); track.scrollBy({ left: -step() }); }
      });
      // Dim any card that is cut off at the edge
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          entries =>
            entries.forEach(e =>
              e.target.classList.toggle("is-dim", e.intersectionRatio < 0.97)
            ),
          { root: track, threshold: Array.from({ length: 21 }, (_, i) => i / 20) }
        );
        cards.forEach(c => io.observe(c));
      }
      track.addEventListener("scroll", () => requestAnimationFrame(sync), { passive: true });
      window.addEventListener("resize", sync);
      sync();
    }
    document.getElementById("vidClose")?.addEventListener("click", close);
    modal?.addEventListener("mousedown", e => {
      if (e.target === modal) close();
    });
    window.addEventListener("keydown", e => {
      if (e.key === "Escape" && modal && !modal.hidden) close();
    });
  </script>
</Layout>
