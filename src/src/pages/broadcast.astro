---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import getUniqueTags from "@utils/getUniqueTags";
import { getVideos, getShows } from "@utils/videos";
import "@styles/base.css";
import AppNavbar from "@components/AppNavbar";
import AppFooter from "@components/AppFooter.astro";
import VideoCarousel from "@components/VideoCarousel.astro";
import NavGlass from "@components/NavGlass.astro";

// Works at a domain root ("/") and under a sub-folder
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");

/* Navbar links: same as the home page, BROADCAST is always last */
const posts = await getCollection("blog");
const allTags = getUniqueTags(posts);
const navLinks = [
  { label: "HOME", href: `${BASE}/` },
  ...allTags.map(t => ({
    label: t.tagName.toUpperCase(),
    href: `${BASE}/tags/${t.tag}`,
  })),
  { label: "BROADCAST", href: `${BASE}/broadcast` },
];

/* Broadcast items live in src/content/videos/*.md */
const videos = await getVideos();
const shows = getShows(videos);
---

<Layout title="JourKnows | Broadcast">
  <script is:inline data-astro-rerun>
    document.documentElement.classList.add("jk-js");
  </script>

  <div class="font-display min-h-[100vh] bg-[#fdfdfb] m-0 p-0 text-[#1e1e1e]">
    <AppNavbar client:load activeHref={`${BASE}/broadcast`} navLinks={navLinks} />

    <main id="main" class="jk-vid">
      <div class="jk-vid-in is-rows">
        <VideoCarousel
          title="Broadcast"
          subtitle="From the JourKnows Broadcasting Desk."
          videos={videos}
        />

        {/* One row per desk / show, each with its own page */}
        {
          shows.length > 1 &&
            shows.map(s => (
              <VideoCarousel
                title={s.name}
                videos={s.videos}
                href={`${BASE}/broadcast/${s.slug}`}
                hrefLabel={`Open ${s.name}`}
              />
            ))
        }
      </div>
    </main>

    <AppFooter />
    <NavGlass />
  </div>
</Layout>
