---
interface Props {
  points: string[];
  source?: "ai" | "auto";
}
const { points, source = "auto" } = Astro.props;
---

{
  points.length > 0 && (
    <aside class="jk-tldr" aria-label="Story summary">
      <div class="jk-tldr-head">
        ✦ {source === "ai" ? "AI SUMMARY" : "QUICK SUMMARY"}
        <span class="jk-tldr-note">
          {source === "ai" ? "Generated from the article" : "Auto-extracted key points"}
        </span>
      </div>
      <ul>
        {points.map(p => <li>{p}</li>)}
      </ul>
    </aside>
  )
}
