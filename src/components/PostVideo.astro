---
import { getInlineEmbed } from "@utils/videos";
const { url, title = "Video" } = Astro.props;
const v = url ? getInlineEmbed(url) : null;
---
{v && v.kind !== "file" && (
  <div style="position:relative;width:100%;aspect-ratio:16/9;margin:1.5rem 0;">
    <iframe
      src={v.src}
      title={title}
      style="position:absolute;inset:0;width:100%;height:100%;border:0;"
      allow="encrypted-media; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
    ></iframe>
  </div>
)}
{v && v.kind === "file" && (
  <video src={v.src} controls style="width:100%;aspect-ratio:16/9;margin:1.5rem 0;"></video>
)}
